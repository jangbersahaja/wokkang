# StoreHub API Configuration
# Your StoreHub store name (subdomain from back-office URL)
STOREHUB_USERNAME=yourstorename

# Your StoreHub API token (contact StoreHub support to get this)
STOREHUB_PASSWORD=your-api-token-here

# StoreHub API Base URL (usually no need to change)
NEXT_PUBLIC_STOREHUB_API_BASE=https://api.storehubhq.com

# Auth
# Neon Postgres connection string (used for users/invites)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Secret used to sign session JWT cookies — set a long random string
SESSION_SECRET=replace-with-a-long-random-string

